# Copy to .env, then restart Expo after any change.
# URL of the Vmax API (../server):
#   Android emulator -> http://10.0.2.2:3000   (10.0.2.2 is your computer, seen from the emulator)
#   Physical phone   -> http://<your computer's LAN IP>:3000   (same Wi-Fi)
#   Web / iOS sim    -> http://localhost:3000
EXPO_PUBLIC_BACKEND_API_URL=http://10.0.2.2:3000
