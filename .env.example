# Copy this file to .env and fill in the values. Never commit .env.

# Port the API listens on
PORT=3000

# PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_USER=vmax
PG_PASSWORD=change-me
PG_DATABASE=vmax
# false for a local PostgreSQL; true for cloud databases that require SSL (e.g. AWS RDS)
PG_SSL=false

# Secret used to sign login tokens. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional; defaults to JWT_SECRET
SESSION_SECRET=

# DeepSeek API key (chatbot, receipt scanning, advice)
DEEPSEEK_API_KEY=
